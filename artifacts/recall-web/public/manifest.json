{
  "id": "/",
  "name": "Recall AI",
  "short_name": "Recall",
  "description": "Your AI second brain. Save, summarise, and understand anything — articles, PDFs, videos, and voice notes.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#060e20",
  "theme_color": "#a3a6ff",
  "categories": ["productivity", "education", "utilities", "books", "news"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-home.jpg",
      "sizes": "412x915",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Recall home screen on mobile"
    },
    {
      "src": "/screenshots/desktop-home.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Recall dashboard on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Save Article",
      "short_name": "Save",
      "description": "Quickly save and summarise a URL",
      "url": "/?action=save",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Voice Note",
      "short_name": "Voice",
      "description": "Capture a thought with your voice",
      "url": "/voice-notes?action=new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Browse your saved knowledge",
      "url": "/saved",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Insights",
      "short_name": "Insights",
      "description": "View your reading DNA and streak",
      "url": "/insights",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/plain": [".txt", ".md", ".markdown"],
        "application/json": [".json"],
        "text/csv": [".csv"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+recall",
      "url": "/?url=%s"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "/notes?action=new"
  },
  "handle_links": "preferred"
}
